{
  "name": "Development Environment",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bullseye",
  "forwardPorts": [8501],
  "mounts": ["source=${localWorkspaceFolder},target=/home/vscode/workspace,type=bind"],
  "workspaceFolder": "/home/vscode/workspace",
  "remoteUser": "vscode",
  "postCreateCommand": "python -m pip install --user -r requirements.txt && python -m pip install --user pre-commit && pre-commit install",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter",
        "ms-python.isort",
        "ms-python.flake8",
        "treddy1012.vscode-pre-commit"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python3",
        "python.linting.enabled": true,
        "python.linting.flake8Enabled": true,
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        },
        "preCommit.enable": true
      }
    }
  }
}
